{
  "compileOnSave": false,
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@org/shared-translations": ["./libs/shared-translations/src/index.ts"],
      "@org/auth": ["./libs/auth/src/public-api.ts"],
      "@org/shared-styles": ["libs/shared-styles/src/index.ts"],
      "@Ui-components": ["libs/Ui-Components/src/index.ts"],
      "dashboard/Routes": [
        "apps/dashboard/src/app/remote-entry/entry.routes.ts"
      ],
      "@my-org/sharedInp": ["libs/shared/sharedInp/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
